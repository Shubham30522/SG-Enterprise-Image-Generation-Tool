{
    "name": "Meesho Catalog Edit",
    "browser": "Chrome",
    "actions": [
        {
            "slno": 1,
            "action": "goToURL",
            "value": "{url}",
            "error": "Error at step 1: Failed to navigate to Meesho catalog page"
        },
        {
            "slno": 2,
            "action": "waitForPageLoad",
            "error": "Error at step 2: Page did not load completely"
        },
        {
            "slno": 3,
            "action": "wait",
            "value": "3000",
            "error": "Error at step 3: Wait failed after page load"
        },
        {
            "slno": 4,
            "action": "checkLoginRequired",
            "error": "Error at step 4: Login check/handling failed"
        },
        {
            "slno": 5,
            "action": "wait",
            "value": "5000",
            "error": "Error at step 5: Wait failed for dynamic content"
        },
        {
            "slno": 6,
            "action": "scrollToBottom",
            "error": "Error at step 6: Failed to scroll to bottom of page"
        },
        {
            "slno": 7,
            "action": "wait",
            "value": "2000",
            "error": "Error at step 7: Wait failed after scroll"
        },
        {
            "slno": 8,
            "action": "waitUntilVisible",
            "selector": "xpath=//button[.//span[contains(text(), 'Edit Catalog')]]",
            "timeout": "30000",
            "error": "Error at step 8: 'Edit Catalog' button not visible within timeout"
        },
        {
            "slno": 9,
            "action": "scrollIntoView",
            "selector": "xpath=//button[.//span[contains(text(), 'Edit Catalog')]]",
            "error": "Error at step 9: Failed to scroll 'Edit Catalog' button into view"
        },
        {
            "slno": 10,
            "action": "wait",
            "value": "1000",
            "error": "Error at step 10: Wait failed before clicking Edit Catalog"
        },
        {
            "slno": 11,
            "action": "clickElement",
            "selector": "xpath=//button[.//span[contains(text(), 'Edit Catalog')]]",
            "error": "Error at step 11: Failed to click 'Edit Catalog' button"
        },
        {
            "slno": 12,
            "action": "waitForPageLoad",
            "error": "Error at step 12: Navigation after Edit Catalog click failed"
        },
        {
            "slno": 13,
            "action": "wait",
            "value": "5000",
            "error": "Error at step 13: Wait failed after navigation"
        },
        {
            "slno": 14,
            "action": "scrollToBottom",
            "error": "Error at step 14: Failed to scroll on edit page"
        },
        {
            "slno": 15,
            "action": "wait",
            "value": "2000",
            "error": "Error at step 15: Wait failed after scroll on edit page"
        },
        {
            "slno": 16,
            "action": "clickElement",
            "selector": "xpath=//button[contains(text(), 'CHANGE')] | //button[contains(text(), 'Change')] | //span[contains(text(), 'CHANGE')]/ancestor::button",
            "error": "Error at step 16: Failed to click 'CHANGE' button"
        }
    ]
}